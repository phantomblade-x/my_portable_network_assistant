
---

## config.yaml.example

```yaml
# Serial connection to switch
serial:
  port: /dev/ttyUSB0
  baud: 9600
  timeout: 2

# Audio devices (use 'arecord -l' and 'aplay -l' to find)
audio:
  mic_device: default
  speaker_device: default
  sample_rate: 16000

# Spoken password for exec commands
# Pick something distinct that won't be misheard
exec_password: "alpha bravo charlie"

# Wake word (say this to activate)
wake_word: "hey cisco"

# Model paths (relative to project root)
models:
  whisper: models/whisper-base.en.bin
  llm: models/llama-3.2-1b-q4_k_m.gguf
  piper_model: models/en_US-lessac-medium.onnx
  piper_config: models/en_US-lessac-medium.onnx.json

# LLM settings
llm:
  context_length: 2048
  max_tokens: 256
  temperature: 0.1
  threads: 4

# Timeouts
timeouts:
  listen: 10
  command: 5